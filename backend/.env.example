# ==========================================
# MODULE 1: CORE APPLICATION ENVIRONMENTS
# ==========================================
APP_ENV=development

# Signs every session cookie (dash / events / minister / display / dept).
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit a real value here. Rotate by changing this in prod .env.
SECRET_KEY=CHANGE_ME__generate_with__python_secrets_token_hex_32

# ==========================================
# POSTGRESQL DATABASE LOGISTICS
# ==========================================
# LOCAL PostgreSQL for development.
# IMPORTANT: set DB_PASSWORD to YOUR local Postgres password.
DB_USER=postgres
DB_PASSWORD=CHANGE_ME__local_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vps_dryrun

# ==========================================
# SECURITY TIMEOUT MATRIX (IN SECONDS)
# ==========================================
QR_EXPIRY_SECONDS=60
SESSION_EXPIRY_SECONDS=900

# Database Configuration
# For local dev the app builds the connection from the DB_* vars above (local
# Postgres). To point at a shared / prod DB, uncomment DATABASE_URL below and
# fill in host / user / password from your team's secret store — NEVER commit
# the real credentials here.
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:<port>/<db>


# Frontend Configuration
FRONTEND_FORM_BASE_URL=http://localhost:8000/form
SERVER_BASE_URL=http://localhost:8000
BASE_URL=http://localhost:8000

# Application Configuration
APP_NAME=Citizen Scheduler API
APP_VERSION=1.0.0
# DEBUG=True bypasses production safety checks — LOCAL DEV ONLY.
# Prod .env MUST set DEBUG=False.
DEBUG=True

# ==========================================
# SMS GATEWAY — APM Technologies (active)
# ==========================================
# The active OTP sender. Obtain the key from the APM Technologies console.
APM_SMS_API_KEY=CHANGE_ME__obtain_from_apm_console

# MSG91 removed — the app uses APM Technologies SMS (above). MSG91 is not
# wired anywhere in the code. If you switch providers, add the new vars
# where the wiring happens, not here.

# ==========================================
# STAFF DASHBOARD LOGIN
# ==========================================
# TEMPORARY env-based login for the /dashboard. Prod MUST change this before
# launch. Long-term: staff logins live in the Login table (see events_auth).
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_ME__strong_random_password

# Display Board Credentials
DISPLAY_USERNAME=display
DISPLAY_PASSWORD=CHANGE_ME__strong_random_password

# Twilio (commented out — replaced by APM SMS)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+1XXXXXXXXXX


# ==========================================
# GEMINI / VERTEX AI — grievance summarisation & extraction
# ==========================================
# Direct Gemini API key OR Vertex service-account. Obtain from Google AI Studio
# / GCP console; NEVER commit the real key or the service-account JSON.
GEMINI_API_KEY=CHANGE_ME__obtain_from_google_ai_studio
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_SERVICE_TIER=priority

# Vertex path — point at a service-account JSON kept OUTSIDE the repo tree
# (e.g. /etc/vpa/vertex.json), or use GOOGLE_APPLICATION_CREDENTIALS / ADC.
# VERTEX_SERVICE_ACCOUNT_JSON=/etc/vpa/vertex-service-account.json
# VERTEX_PROJECT_ID=CHANGE_ME__gcp_project_id
# VERTEX_LOCATION=us-central1

# ==========================================
# AUDIO RECORDING (seconds)
# ==========================================
AUDIO_MIN_DURATION_SECONDS=10
AUDIO_MAX_DURATION_SECONDS=300

MAX_FILE_SIZE_MB=5
ALLOWED_FILE_EXTENSIONS=.pdf,.jpg,.jpeg,.png

# ==========================================
# MLA Profile (for seed_mla.py / init_db.py)
# ==========================================
MLA_NAME=Default MLA
MLA_CONSTITUENCY=Default Constituency
MLA_CONTACT_MOBILE=
MLA_CONTACT_EMAIL=
MLA_OFFICE_ADDRESS=

# ==========================================
# BLOB STORAGE — MinIO / S3-compatible
# ==========================================
# Endpoint MUST be https:// in production; plaintext HTTP leaks uploads and
# credentials over the network. Access + secret keys come from the MinIO
# console — NEVER commit real values.
FILE_STORAGE_ENDPOINT=https://storage.example.internal
FILE_STORAGE_ACCESS_KEY=CHANGE_ME__minio_access_key
FILE_STORAGE_SECRET_KEY=CHANGE_ME__minio_secret_key
FILE_STORAGE_BUCKET=vpa-uploads
# FILE_STORAGE_PUBLIC_URL=https://your-cdn-or-proxy

# ==========================================
# ERROR TRACKING — Sentry (optional but recommended for prod)
# ==========================================
# Silent in dev when unset. Prod SHOULD set this or errors are invisible.
# SENTRY_DSN=CHANGE_ME__obtain_from_sentry

# ==========================================
# SECURITY CONFIGS
# ==========================================
# 32-byte Fernet key for PII encryption at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER commit a real value. Rotating this key requires re-encrypting existing
# PII rows (see backend/encrypt_pii.py).
ENCRYPTION_KEY=CHANGE_ME__generate_with__fernet_generate_key

# Set to True whenever the site is served over HTTPS (staging / prod).
# Session cookies are only sent over HTTPS when True — required in prod.
COOKIE_SECURE=false

# Rate limiter — SHOULD be True in production to guard login + OTP against
# credential-stuffing / OTP-enumeration. Off by default so local dev can
# hammer the same phone. Enable only once your reverse proxy is confirmed to
# forward the real client IP via X-Forwarded-For (otherwise a shared-egress
# subnet becomes one bucket and legit traffic self-DOSes).
RATE_LIMIT_ENABLED=false

# CORS — comma-separated origin list. Prod MUST NOT include localhost.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
